{
  // The page (src/renderer), type checked only: esbuild bundles it (scripts/bundle.js). No Node types, since the
  // page is sandboxed and can't use Node.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src/renderer"]
}
