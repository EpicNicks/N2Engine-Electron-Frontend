{
  "name": "n2enginewebfrontend",
  "version": "1.0.0",
  "description": "A web frontend for editing N2Engine projects",
  "license": "MIT",
  "author": "Nicholas Cerisano",
  "type": "commonjs",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=21"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/bundle.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --devtools",
    "sync-protocol": "node scripts/sync-protocol.js",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "electron": "^39.2.7",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "@preact/signals-core": "^1.14.4",
    "preact": "^11.0.0"
  }
}
