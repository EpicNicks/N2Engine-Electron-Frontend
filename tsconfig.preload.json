{
  // The preload, type checked only: esbuild bundles it (scripts/bundle.js), since a sandboxed preload can require
  // only "electron"
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/preload"]
}
