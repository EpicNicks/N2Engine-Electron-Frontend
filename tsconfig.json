{
  // The Node side: the main process, the preload, the protocol client and the unit tests, compiled to dist for
  // Electron and node --test. The page has its own config (tsconfig.renderer.json), without Node's types.
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["src/renderer/renderer.ts"]
}
